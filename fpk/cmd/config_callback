#!/bin/sh
set -eu
if [ -n "${TRIM_AUTHORIZATION_PATHS:-}" ]; then
  workspace=${TRIM_AUTHORIZATION_PATHS%%:*}
  if [ -f "$TRIM_PKGETC/app.env" ]; then
    tmp_file="$TRIM_PKGTMP/app.env.$$"
    grep -v '^WORKSPACE_BASE=' "$TRIM_PKGETC/app.env" >"$tmp_file" || true
    printf 'WORKSPACE_BASE=%s\n' "$workspace" >>"$tmp_file"
    mv "$tmp_file" "$TRIM_PKGETC/app.env"
  else
    printf 'WORKSPACE_BASE=%s\nCHROME_REMOTE_DEBUG_URL=\n' "$workspace" >"$TRIM_PKGETC/app.env"
  fi
fi
echo 'Configure workspace, browser and platform credentials in Hermes Studio.'
exit 0
