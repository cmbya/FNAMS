#!/bin/sh
set -eu

if [ -f "${TRIM_PKGETC:-}/app.env" ]; then
  . "${TRIM_PKGETC}/app.env"
fi

APP_ROOT=${TRIM_APPDEST:?TRIM_APPDEST is required}
PKG_VAR=${TRIM_PKGVAR:-${APP_ROOT}/var}
PKG_TMP=${TRIM_PKGTMP:-${PKG_VAR}/tmp}
NODE=${APP_ROOT}/runtime/node/bin/node
STUDIO_ROOT=${APP_ROOT}/studio
STUDIO_ENTRY=${STUDIO_ROOT}/bin/hermes-web-ui.mjs
LOG_DIR=${LOG_DIR:-${PKG_VAR}/logs}
APP_LOG=${APP_LOG:-${LOG_DIR}/app.log}
LOGFILE=${LOGFILE:-${LOG_DIR}/studio.log}
INSTALL_LOG=${INSTALL_LOG:-${LOG_DIR}/install.log}
VIEWER_LOG=${VIEWER_LOG:-${LOG_DIR}/log-viewer.log}
PIDFILE=${PKG_VAR}/hermes-studio.pid
VIEWER_PIDFILE=${PKG_VAR}/hermes-studio-log-viewer.pid
VIEWER_SCRIPT=${APP_ROOT}/logs/log_server.mjs
WEB_UI_HOME=${HERMES_WEB_UI_HOME:-${PKG_VAR}/web-ui}
AGENT_HOME=${AGENT_HOME:-}

# HermesAgent writes a small world-readable path file beside its launcher.
# This avoids assuming the unavailable /var/apps/HermesAgent/share/data path.
agent_launcher=${HERMES_BIN:-/usr/local/bin/hermes-fnos}
agent_launcher_real=$(readlink -f "$agent_launcher" 2>/dev/null || true)
if [ -n "$agent_launcher_real" ]; then
  agent_root=$(CDPATH= cd -- "$(dirname -- "$agent_launcher_real")/.." 2>/dev/null && pwd || true)
  agent_metadata=${agent_root:+${agent_root}/.hermes-agent-fnos.env}
  if [ -n "${agent_metadata:-}" ] && [ -r "$agent_metadata" ]; then
    . "$agent_metadata"
    AGENT_HOME=${HERMES_HOME:-$AGENT_HOME}
  fi
fi

if [ -n "$AGENT_HOME" ]; then export HERMES_HOME=$AGENT_HOME; else unset HERMES_HOME 2>/dev/null || true; fi
export HERMES_BIN=${HERMES_BIN:-/usr/local/bin/hermes-fnos}
export HERMES_AGENT_BRIDGE_PYTHON=${HERMES_AGENT_BRIDGE_PYTHON:-/usr/local/bin/hermes-python-fnos}
export HERMES_AGENT_BRIDGE_UV=${HERMES_AGENT_BRIDGE_UV:-/usr/local/bin/hermes-uv-fnos}
export HERMES_AGENT_BRIDGE_ENDPOINT=${HERMES_AGENT_BRIDGE_ENDPOINT:-ipc://${PKG_TMP}/hermes-agent-bridge.sock}
export HERMES_AGENT_BRIDGE_WORKER_TRANSPORT=${HERMES_AGENT_BRIDGE_WORKER_TRANSPORT:-ipc}
export HERMES_GATEWAY_URL=${HERMES_GATEWAY_URL:-http://127.0.0.1:8642}
export GATEWAY_URL=${GATEWAY_URL:-${HERMES_GATEWAY_URL}}
export HERMES_WEB_UI_MANAGED_GATEWAY=0
export HERMES_WEB_UI_DISABLE_GATEWAY_AUTOSTART=1
export HERMES_WEB_UI_STOP_GATEWAYS_ON_SHUTDOWN=0
export PATH=${APP_ROOT}/runtime/node/bin:/usr/local/bin:${PATH}
export NODE_ENV=production
export BIND_HOST=${BIND_HOST:-0.0.0.0}
export PORT=${HERMES_STUDIO_PORT:-8648}
export HERMES_LOG_DIR=${LOG_DIR}
export HERMES_LOG_APP_NAME="Hermes Studio"
export HERMES_LOG_VIEWER_PORT=${HERMES_LOG_VIEWER_PORT:-8649}
export HERMES_LOG_VIEWER_BIND=${HERMES_LOG_VIEWER_BIND:-0.0.0.0}
export HERMES_WEB_UI_HOME=${WEB_UI_HOME}

mkdir -p "${LOG_DIR}" "${PKG_TMP}" "${WEB_UI_HOME}"

log_msg() {
  printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "${HERMES_LOG_APP_NAME}" "$*" >>"${APP_LOG}"
}
