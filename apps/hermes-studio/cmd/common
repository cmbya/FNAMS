#!/bin/sh
set -eu

if [ -f "${TRIM_PKGETC:-}/app.env" ]; then
  . "${TRIM_PKGETC}/app.env"
fi

APP_ROOT=${TRIM_APPDEST:?TRIM_APPDEST is required}
PKG_VAR=${TRIM_PKGVAR:-${APP_ROOT}/var}
PKG_TMP=${TRIM_PKGTMP:-${PKG_VAR}/tmp}
NODE=${APP_ROOT}/runtime/node/bin/node
STUDIO_ROOT=${APP_ROOT}/studio
STUDIO_ENTRY=${STUDIO_ROOT}/bin/hermes-web-ui.mjs
LOG_DIR=${LOG_DIR:-${PKG_VAR}/logs}
APP_LOG=${APP_LOG:-${LOG_DIR}/app.log}
LOGFILE=${LOGFILE:-${LOG_DIR}/studio.log}
INSTALL_LOG=${INSTALL_LOG:-${LOG_DIR}/install.log}
VIEWER_LOG=${VIEWER_LOG:-${LOG_DIR}/log-viewer.log}
PIDFILE=${PKG_VAR}/hermes-studio.pid
VIEWER_PIDFILE=${PKG_VAR}/hermes-studio-log-viewer.pid
VIEWER_SCRIPT=${APP_ROOT}/logs/log_server.mjs
WEB_UI_HOME=${HERMES_WEB_UI_HOME:-${PKG_VAR}/web-ui}
AGENT_HOME=${AGENT_HOME:-}

# fnOS keeps both application roots and application shares beneath the same
# volume.  The real paths observed on fnOS 1.2 are, for example,
# /vol2/@appcenter/HermesStudio and /vol2/@appshare/HermesAgent/data.
# Deriving from this application's root works even when /var/apps and the
# usr-local linker are unavailable to package users.
FNOS_VOLUME=$(CDPATH= cd -- "$(dirname -- "$APP_ROOT")/.." 2>/dev/null && pwd || true)
AGENT_APP_ROOT=${FNOS_VOLUME:+${FNOS_VOLUME}/@appcenter/HermesAgent}
AGENT_SHARE_HOME=${FNOS_VOLUME:+${FNOS_VOLUME}/@appshare/HermesAgent/data}
if [ -n "$AGENT_SHARE_HOME" ] && [ -d "$AGENT_SHARE_HOME" ]; then
  AGENT_HOME=$AGENT_SHARE_HOME
fi

# Prefer the actual Agent package launchers. Their wrappers locate the Agent
# runtime even though TRIM_APPDEST belongs to Hermes Studio at this point.
if [ -z "${HERMES_BIN:-}" ] && [ -n "$AGENT_APP_ROOT" ] && [ -x "$AGENT_APP_ROOT/bin/hermes-fnos" ]; then
  HERMES_BIN=$AGENT_APP_ROOT/bin/hermes-fnos
fi
if [ -z "${HERMES_AGENT_BRIDGE_PYTHON:-}" ] && [ -n "$AGENT_APP_ROOT" ] && [ -x "$AGENT_APP_ROOT/bin/hermes-python-fnos" ]; then
  HERMES_AGENT_BRIDGE_PYTHON=$AGENT_APP_ROOT/bin/hermes-python-fnos
fi
if [ -z "${HERMES_AGENT_BRIDGE_UV:-}" ] && [ -n "$AGENT_APP_ROOT" ] && [ -x "$AGENT_APP_ROOT/bin/hermes-uv-fnos" ]; then
  HERMES_AGENT_BRIDGE_UV=$AGENT_APP_ROOT/bin/hermes-uv-fnos
fi

# Older installations may not use the standard sibling paths. Fall back to
# Agent metadata beside the resolved launcher when it is available.
agent_launcher=${HERMES_BIN:-/usr/local/bin/hermes-fnos}
agent_launcher_real=$(readlink -f "$agent_launcher" 2>/dev/null || true)
if [ -n "$agent_launcher_real" ]; then
  agent_root=$(CDPATH= cd -- "$(dirname -- "$agent_launcher_real")/.." 2>/dev/null && pwd || true)
  agent_metadata=${agent_root:+${agent_root}/.hermes-agent-fnos.env}
  if [ -n "${agent_metadata:-}" ] && [ -r "$agent_metadata" ]; then
    . "$agent_metadata"
    [ -n "$AGENT_HOME" ] || AGENT_HOME=${HERMES_HOME:-}
  fi
fi

if [ -n "$AGENT_HOME" ]; then export HERMES_HOME=$AGENT_HOME; else unset HERMES_HOME 2>/dev/null || true; fi

# Reuse the Agent's authorized workspace when it is available. Older Agent
# installs may not have persisted WORKSPACE_DIR; in that case create a private
# default workspace below the Agent home so Studio can chat immediately while
# still keeping all user-file access inside an explicit base directory.
if [ -z "${WORKSPACE_DIR:-}" ] && [ -n "${TRIM_DATA_ACCESSIBLE_PATHS:-}" ]; then
  WORKSPACE_DIR=${TRIM_DATA_ACCESSIBLE_PATHS%%:*}
fi
WORKSPACE_BASE=${WORKSPACE_BASE:-${WORKSPACE_DIR:-}}
if [ -z "$WORKSPACE_BASE" ] && [ -n "$AGENT_HOME" ]; then
  workspace_fallback=${AGENT_HOME}/workspace
  if mkdir -p "$workspace_fallback" 2>/dev/null; then
    WORKSPACE_BASE=$workspace_fallback
    WORKSPACE_DIR=$workspace_fallback
  fi
fi
if [ -n "${WORKSPACE_BASE:-}" ]; then
  export WORKSPACE_BASE
  export WORKSPACE_DIR=${WORKSPACE_DIR:-$WORKSPACE_BASE}
else
  unset WORKSPACE_BASE WORKSPACE_DIR 2>/dev/null || true
fi

# The bundled Agent runtime installs run_agent.py into Python's
# site-packages directory rather than directly below @appcenter/HermesAgent.
# Hermes Studio's upstream bridge resolver needs that directory as
# HERMES_AGENT_ROOT; without it the bridge exits before creating its IPC
# socket with "run_agent.py not found".
if [ -z "${HERMES_AGENT_ROOT:-}" ] && [ -n "${AGENT_APP_ROOT:-}" ]; then
  for agent_root_candidate in \
    "${AGENT_APP_ROOT}/runtime/python/lib/python3.11/site-packages" \
    "${AGENT_APP_ROOT}/runtime/python/lib/python3.12/site-packages" \
    "${AGENT_APP_ROOT}/runtime/python/lib/python3.13/site-packages" \
    "${AGENT_APP_ROOT}"; do
    if [ -f "${agent_root_candidate}/run_agent.py" ]; then
      HERMES_AGENT_ROOT=${agent_root_candidate}
      break
    fi
  done
fi

# A package upgrade can leave @appdata/HermesStudio owned by the previous
# package user.  Keep the app usable in that situation by placing Studio's
# private state below the already shared Agent home.  This does not change
# the Agent's configuration or workspace; it only provides Studio with a
# writable place for its own logs, pid files, temporary socket, and web UI
# database.
ORIGINAL_PKG_VAR=$PKG_VAR
STUDIO_RUNTIME_ROOT=
if [ ! -d "$PKG_VAR" ] || [ ! -r "$PKG_VAR" ] || [ ! -w "$PKG_VAR" ] || [ ! -x "$PKG_VAR" ]; then
  studio_fallback_root=${AGENT_HOME:+${AGENT_HOME}/.hermes-studio}
  if [ -n "$studio_fallback_root" ] && mkdir -p "$studio_fallback_root" 2>/dev/null \
    && [ -r "$studio_fallback_root" ] && [ -w "$studio_fallback_root" ] && [ -x "$studio_fallback_root" ]; then
    STUDIO_RUNTIME_ROOT=$studio_fallback_root
  fi
fi
if [ -n "$STUDIO_RUNTIME_ROOT" ]; then
  PKG_VAR=$STUDIO_RUNTIME_ROOT
  PKG_TMP=${PKG_VAR}/tmp
  LOG_DIR=${PKG_VAR}/logs
  APP_LOG=${LOG_DIR}/app.log
  LOGFILE=${LOG_DIR}/studio.log
  INSTALL_LOG=${LOG_DIR}/install.log
  VIEWER_LOG=${LOG_DIR}/log-viewer.log
  WEB_UI_HOME=${PKG_VAR}/web-ui
fi

export HERMES_BIN=${HERMES_BIN:-/usr/local/bin/hermes-fnos}
if [ -n "${HERMES_AGENT_ROOT:-}" ]; then
  export HERMES_AGENT_ROOT
else
  unset HERMES_AGENT_ROOT 2>/dev/null || true
fi
HERMES_AGENT_BRIDGE_PYTHON_REAL=${HERMES_AGENT_BRIDGE_PYTHON:-/usr/local/bin/hermes-python-fnos}
HERMES_AGENT_BRIDGE_PYTHON=${HERMES_AGENT_BRIDGE_PYTHON_REAL}
if [ -x "${APP_ROOT}/bin/hermes-studio-bridge-python" ]; then
  HERMES_AGENT_BRIDGE_PYTHON=${APP_ROOT}/bin/hermes-studio-bridge-python
fi
export HERMES_AGENT_BRIDGE_PYTHON
export HERMES_AGENT_BRIDGE_UV=${HERMES_AGENT_BRIDGE_UV:-/usr/local/bin/hermes-uv-fnos}
export HERMES_AGENT_BRIDGE_PYTHON_REAL
export HERMES_AGENT_BRIDGE_ENDPOINT=${HERMES_AGENT_BRIDGE_ENDPOINT:-ipc://${PKG_TMP}/hermes-agent-bridge.sock}
export HERMES_AGENT_BRIDGE_WORKER_TRANSPORT=${HERMES_AGENT_BRIDGE_WORKER_TRANSPORT:-ipc}
export HERMES_GATEWAY_URL=${HERMES_GATEWAY_URL:-http://127.0.0.1:8642}
export GATEWAY_URL=${GATEWAY_URL:-${HERMES_GATEWAY_URL}}
export HERMES_WEB_UI_MANAGED_GATEWAY=0
export HERMES_WEB_UI_DISABLE_GATEWAY_AUTOSTART=1
export HERMES_WEB_UI_STOP_GATEWAYS_ON_SHUTDOWN=0
export PATH=${APP_ROOT}/runtime/node/bin:/usr/local/bin:${PATH}
export NODE_ENV=production
export BIND_HOST=${BIND_HOST:-0.0.0.0}
export PORT=${HERMES_STUDIO_PORT:-8648}
export HERMES_LOG_DIR=${LOG_DIR}
export HERMES_LOG_APP_NAME="Hermes Studio"
export HERMES_LOG_VIEWER_PORT=${HERMES_LOG_VIEWER_PORT:-8649}
export HERMES_LOG_VIEWER_BIND=${HERMES_LOG_VIEWER_BIND:-0.0.0.0}
export HERMES_WEB_UI_HOME=${WEB_UI_HOME}
export HERMES_STUDIO_ORIGINAL_PKG_VAR=${ORIGINAL_PKG_VAR}
export HERMES_AGENT_BRIDGE_LOG=${HERMES_AGENT_BRIDGE_LOG:-${LOG_DIR}/agent-bridge.log}

if ! mkdir -p "${LOG_DIR}" "${PKG_TMP}" "${WEB_UI_HOME}" 2>/dev/null; then
  startup_log=${TRIM_TEMP_LOGFILE:-/tmp/HermesStudio-startup-error.log}
  printf '%s [Hermes Studio] ERROR: unable to initialize writable Studio runtime directories; original_pkgvar=%s runtime_root=%s agent_home=%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S%z')" "$ORIGINAL_PKG_VAR" "${STUDIO_RUNTIME_ROOT:-<appdata>}" "${AGENT_HOME:-<unresolved>}" >>"$startup_log" 2>/dev/null || true
  return 1 2>/dev/null || exit 1
fi

log_msg() {
  printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "${HERMES_LOG_APP_NAME}" "$*" >>"${APP_LOG}"
}

log_runtime_identity() {
  runtime_user=$(id 2>&1 || true)
  runtime_paths=$(ls -ld "${APP_ROOT}" "${ORIGINAL_PKG_VAR}" "${PKG_VAR}" "${AGENT_HOME:-/nonexistent}" "${AGENT_HOME:-/nonexistent}/skills" 2>&1 || true)
  log_msg "runtime identity: ${runtime_user}"
  log_msg "runtime paths: $(printf '%s' "${runtime_paths}" | tr '\n' ';')"
  if [ -n "${STUDIO_RUNTIME_ROOT}" ]; then
    log_msg "runtime fallback: original_pkgvar=${ORIGINAL_PKG_VAR}; runtime_root=${STUDIO_RUNTIME_ROOT}"
  fi
}
