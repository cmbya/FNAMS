#!/bin/sh
set -eu

. "$(dirname "$0")/common"

is_running() {
  [ -s "$PIDFILE" ] || return 1
  pid=$(cat "$PIDFILE")
  kill -0 "$pid" 2>/dev/null
}

start() {
  if is_running; then
    echo 'Hermes Studio is already running'
    exit 0
  fi
  test -x "$NODE"
  test -f "$STUDIO_ENTRY"
  test -x /usr/local/bin/hermes-fnos
  test -x /usr/local/bin/hermes-python-fnos
  umask 077
  setsid "$NODE" "$STUDIO_ENTRY" start "$PORT" --no-open >>"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
  sleep 2
  if ! is_running; then
    echo 'Hermes Studio failed to start; check the application log.' >&2
    exit 1
  fi
}

stop() {
  if ! is_running; then
    rm -f "$PIDFILE" "${PKG_TMP}/hermes-agent-bridge.sock"
    exit 0
  fi
  pid=$(cat "$PIDFILE")
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  i=0
  while is_running && [ "$i" -lt 30 ]; do
    sleep 1
    i=$((i + 1))
  done
  if is_running; then
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE" "${PKG_TMP}/hermes-agent-bridge.sock"
}

status() {
  if is_running; then
    echo "Hermes Studio is running on port ${PORT}"
    exit 0
  fi
  echo 'Hermes Studio is not running' >&2
  exit 3
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac

