#!/bin/sh
set -eu

. "$(dirname "$0")/common"

is_running() {
  [ -s "$PIDFILE" ] || return 1
  pid=$(cat "$PIDFILE")
  kill -0 "$pid" 2>/dev/null
}

viewer_is_running() {
  [ -s "$VIEWER_PIDFILE" ] || return 1
  viewer_pid=$(cat "$VIEWER_PIDFILE")
  kill -0 "$viewer_pid" 2>/dev/null
}

start_viewer() {
  if viewer_is_running; then return 0; fi
  test -f "$VIEWER_SCRIPT"
  setsid "$NODE" "$VIEWER_SCRIPT" >>"$VIEWER_LOG" 2>&1 &
  echo $! >"$VIEWER_PIDFILE"
}

stop_viewer() {
  if ! viewer_is_running; then rm -f "$VIEWER_PIDFILE"; return 0; fi
  viewer_pid=$(cat "$VIEWER_PIDFILE")
  kill -TERM -- "-$viewer_pid" 2>/dev/null || kill -TERM "$viewer_pid" 2>/dev/null || true
  i=0
  while viewer_is_running && [ "$i" -lt 10 ]; do sleep 1; i=$((i + 1)); done
  if viewer_is_running; then kill -KILL -- "-$viewer_pid" 2>/dev/null || kill -KILL "$viewer_pid" 2>/dev/null || true; fi
  rm -f "$VIEWER_PIDFILE"
}

start() {
  if is_running; then
    echo 'Hermes Studio is already running'
    exit 0
  fi
  log_msg "start requested; appdest=${APP_ROOT}; pkgvar=${PKG_VAR}; agent_root=${AGENT_APP_ROOT:-<unresolved>}; agent_home=${HERMES_HOME:-<unresolved>}; gateway_url=${HERMES_GATEWAY_URL}"
  log_runtime_identity
  test -x "$NODE"
  test -f "$STUDIO_ENTRY"
  test -x "$HERMES_BIN"
  test -x "$HERMES_AGENT_BRIDGE_PYTHON"
  if [ -z "${HERMES_HOME:-}" ] || [ ! -d "$HERMES_HOME" ]; then
    log_msg "studio preflight failed: Hermes Agent data directory is missing"
    echo 'Hermes Agent data directory is missing; start Hermes Agent first.' >&2
    exit 1
  fi
  if [ ! -r "$HERMES_HOME" ] || [ ! -x "$HERMES_HOME" ] || [ ! -w "$HERMES_HOME" ]; then
    log_msg "studio preflight failed: no rwx access to Hermes Agent data directory"
    echo 'Hermes Studio cannot access Hermes Agent data; reinstall Studio after Agent.' >&2
    exit 1
  fi
  if [ -d "$HERMES_HOME/skills" ] && { [ ! -r "$HERMES_HOME/skills" ] || [ ! -x "$HERMES_HOME/skills" ] || [ ! -w "$HERMES_HOME/skills" ]; }; then
    log_msg "studio preflight failed: no rwx access to Hermes Agent skills directory"
    echo 'Hermes Studio cannot write Hermes Agent skills; reinstall Studio after Agent.' >&2
    exit 1
  fi
  umask 077
  start_viewer
  # `start` daemonizes and exits, which makes fnOS report a false startup
  # failure. Invoke the upstream entry in foreground mode for fnOS to manage.
  setsid "$NODE" "$STUDIO_ENTRY" "$PORT" --no-open >>"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
  sleep 2
  if ! is_running; then
    log_msg "studio failed to start; inspect studio.log and log-viewer.log"
    stop_viewer
    echo 'Hermes Studio failed to start; check the application log.' >&2
    exit 1
  fi
  log_msg "studio started; studio_port=${PORT}; log_viewer_port=${HERMES_LOG_VIEWER_PORT}"
}

stop() {
  log_msg "stop requested"
  if ! is_running; then
    rm -f "$PIDFILE" "${PKG_TMP}/hermes-agent-bridge.sock"
    stop_viewer
    exit 0
  fi
  pid=$(cat "$PIDFILE")
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  i=0
  while is_running && [ "$i" -lt 30 ]; do
    sleep 1
    i=$((i + 1))
  done
  if is_running; then
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE" "${PKG_TMP}/hermes-agent-bridge.sock"
  stop_viewer
  log_msg "stopped"
}

status() {
  if is_running; then
    if viewer_is_running; then
      echo "Hermes Studio is running on port ${PORT}; logs on port ${HERMES_LOG_VIEWER_PORT}"
    else
      echo "Hermes Studio is running on port ${PORT}; log viewer is not running" >&2
    fi
    exit 0
  fi
  echo 'Hermes Studio is not running' >&2
  exit 3
}

logs() {
  case "${2:-all}" in
    all) files="${LOG_DIR}"/*.log ;;
    install|app|studio|log-viewer) files="${LOG_DIR}/${2}.log" ;;
    *) echo "Usage: $0 logs {all|install|app|studio|log-viewer}" >&2; exit 2 ;;
  esac
  for file in $files; do
    [ -f "$file" ] || continue
    echo "===== $(basename "$file") ====="
    tail -n "${HERMES_LOG_LINES:-300}" "$file"
  done
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) logs "$@" ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
