#!/bin/sh
set -u
pkg_etc=${TRIM_PKGETC:-}
pkg_var=${TRIM_PKGVAR:-}
temp_log=${TRIM_TEMP_LOGFILE:-/tmp/HermesStudio-install-error.log}
log_dir=${pkg_var:+${pkg_var}/logs}
[ -n "$log_dir" ] || log_dir=/tmp
mkdir -p "$log_dir" 2>/dev/null || true
line="$(date '+%Y-%m-%d %H:%M:%S%z') [Hermes Studio] config_callback: etc=${pkg_etc:-<missing>} var=${pkg_var:-<missing>}"
printf '%s\n' "$line" >>"$log_dir/install.log" 2>/dev/null || true
printf '%s\n' "$line" >>"$temp_log" 2>/dev/null || true
