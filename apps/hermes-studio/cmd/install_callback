#!/bin/sh
set -u

# Keep diagnostics even when fnOS fails before its normal application-log
# page is available.  Parameter-expansion failures otherwise become only
# "script failed, reason unknown" in App Center.
app_dest=${TRIM_APPDEST:-}
pkg_etc=${TRIM_PKGETC:-}
pkg_var=${TRIM_PKGVAR:-}
temp_log=${TRIM_TEMP_LOGFILE:-/tmp/HermesStudio-install-error.log}
log_dir=${pkg_var:+${pkg_var}/logs}
[ -n "$log_dir" ] || log_dir=/tmp
mkdir -p "$log_dir" 2>/dev/null || true
install_log=${log_dir}/install.log
share_dir=${TRIM_DATA_SHARE_PATHS:-}
share_dir=${share_dir%%:*}
diagnostic_file=
[ -n "$share_dir" ] && diagnostic_file=${share_dir}/HermesStudio-install-diagnostic.log

write_log() {
  line="$(date '+%Y-%m-%d %H:%M:%S%z') [Hermes Studio] $*"
  printf '%s\n' "$line" >>"$install_log" 2>/dev/null || true
  printf '%s\n' "$line" >>"$temp_log" 2>/dev/null || true
  if [ -n "$diagnostic_file" ] && [ -d "$share_dir" ]; then
    printf '%s\n' "$line" >>"$diagnostic_file" 2>/dev/null || true
  fi
}
fail_install() {
  write_log "ERROR: $*"
  write_log "diagnostics: appdest=${app_dest:-<missing>} etc=${pkg_etc:-<missing>} var=${pkg_var:-<missing>} home=${TRIM_PKGHOME:-<missing>} shares=${TRIM_DATA_SHARE_PATHS:-<none>}"
  exit 1
}

[ -n "$app_dest" ] || fail_install "required fnOS variable TRIM_APPDEST is missing"
[ -n "$pkg_etc" ] || fail_install "required fnOS variable TRIM_PKGETC is missing"
[ -n "$pkg_var" ] || fail_install "required fnOS variable TRIM_PKGVAR is missing"
if ! mkdir -p "$pkg_etc" "$pkg_var/logs" 2>>"$install_log"; then
  fail_install "cannot create fnOS configuration or runtime-data directory"
fi
write_log "install_callback started"

# Configuration is intentionally preserved during an upgrade.
if [ -f "${pkg_etc}/app.env" ]; then
  write_log "keeping existing configuration"
  exit 0
fi

agent_home=/var/apps/HermesAgent/share/data
agent_home_exists=false
[ -d "$agent_home" ] && agent_home_exists=true
umask 077
if ! {
  printf 'AGENT_HOME=%s\n' "$agent_home"
  printf 'HERMES_GATEWAY_URL=http://127.0.0.1:8642\n'
  printf 'HERMES_STUDIO_PORT=8648\n'
} >"${pkg_etc}/app.env"; then
  fail_install "cannot write application configuration"
fi
write_log "configured agent_home=${agent_home} agent_share_exists=${agent_home_exists} gateway_url=http://127.0.0.1:8642 studio_port=8648"
