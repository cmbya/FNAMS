#!/bin/sh
set -eu

mkdir -p "${TRIM_PKGETC}" "${TRIM_PKGVAR}/logs"
install_log=${TRIM_PKGVAR}/logs/install.log
printf '%s [Hermes Agent] install_callback started\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" >>"$install_log"
home=/var/apps/HermesAgent/share/data
if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
  candidate=${TRIM_DATA_SHARE_PATHS%%:*}
  [ -d "$candidate" ] && home=$candidate
fi
workspace=${WORKSPACE_DIR:-}
if [ -z "$workspace" ] && [ -n "${TRIM_DATA_ACCESSIBLE_PATHS:-}" ]; then
  workspace=${TRIM_DATA_ACCESSIBLE_PATHS%%:*}
fi
umask 077
{
  printf 'HERMES_HOME=%s\n' "$home"
  printf 'WORKSPACE_DIR=%s\n' "$workspace"
  printf 'HERMES_GATEWAY_PORT=8642\n'
} >"${TRIM_PKGETC}/app.env"
mkdir -p "$home"
printf '%s [Hermes Agent] configured home=%s workspace=%s gateway_port=8642\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$home" "${workspace:-<not-set>}" >>"$install_log"
