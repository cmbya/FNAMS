#!/bin/sh
set -eu

app_dest=${TRIM_APPDEST:?TRIM_APPDEST is required}
pkg_etc=${TRIM_PKGETC:?TRIM_PKGETC is required}
pkg_var=${TRIM_PKGVAR:?TRIM_PKGVAR is required}
mkdir -p "$pkg_etc" "$pkg_var/logs"
install_log=$pkg_var/logs/install.log
log_msg() {
  printf '%s [Hermes Agent] %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$*" >>"$install_log"
}

fail_install() {
  log_msg "ERROR: $*"
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "Hermes Agent installation failed: $* (see ${install_log})" >>"${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
  fi
  exit 1
}

log_msg "install_callback started"

# Keep the user's configured directories during an upgrade.
if [ -f "${pkg_etc}/app.env" ]; then
  log_msg "keeping existing configuration"
  exit 0
fi

home=${TRIM_PKGHOME:-${pkg_var}/home}
if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
  candidate=${TRIM_DATA_SHARE_PATHS%%:*}
  [ -d "$candidate" ] && home=$candidate
fi
workspace=${WORKSPACE_DIR:-}
if [ -z "$workspace" ] && [ -n "${TRIM_DATA_ACCESSIBLE_PATHS:-}" ]; then
  workspace=${TRIM_DATA_ACCESSIBLE_PATHS%%:*}
fi
umask 077
{
  printf 'HERMES_HOME=%s\n' "$home"
  printf 'WORKSPACE_DIR=%s\n' "$workspace"
  printf 'HERMES_GATEWAY_PORT=8642\n'
} >"${pkg_etc}/app.env"
mkdir -p "$home"
log_msg "configured home=${home} workspace=${workspace:-<not-set>} gateway_port=8642"
