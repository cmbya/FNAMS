#!/bin/sh
set -eu

. "$(dirname "$0")/common"

is_running() {
  [ -s "$PIDFILE" ] || return 1
  pid=$(cat "$PIDFILE")
  kill -0 "$pid" 2>/dev/null
}

viewer_is_running() {
  [ -s "$VIEWER_PIDFILE" ] || return 1
  viewer_pid=$(cat "$VIEWER_PIDFILE")
  kill -0 "$viewer_pid" 2>/dev/null
}

gateway_health_probe() {
  "$PYTHON_BIN" - "$1" <<'PY'
import json
import sys
from urllib.request import urlopen

try:
    with urlopen(sys.argv[1], timeout=2) as response:
        payload = json.load(response)
except Exception as exc:
    print(f"{type(exc).__name__}: {exc}", file=sys.stderr)
    raise SystemExit(1)

ready = payload.get("status") == "ok" or payload.get("gateway") == "running"
if ready:
    raise SystemExit(0)

print(
    "unexpected health payload: "
    + json.dumps(payload, ensure_ascii=False)[:500],
    file=sys.stderr,
)
raise SystemExit(1)
PY
}

gateway_health_is_ready() {
  gateway_health_probe "http://127.0.0.1:${HERMES_GATEWAY_PORT}/health" >/dev/null 2>&1 && return 0
  gateway_health_probe "http://127.0.0.1:${HERMES_GATEWAY_PORT}/v1/health" >/dev/null 2>&1
}

gateway_health_diagnose() {
  "$PYTHON_BIN" - "http://127.0.0.1:${HERMES_GATEWAY_PORT}" <<'PY' >>"$APP_LOG" 2>&1 || true
import json
import sys
from urllib.request import urlopen

base_url = sys.argv[1].rstrip("/")
healthy = False
for path in ("/health", "/v1/health"):
    try:
        with urlopen(base_url + path, timeout=2) as response:
            payload = json.load(response)
    except Exception as exc:
        print(f"gateway health {path}: {type(exc).__name__}: {exc}", flush=True)
        continue
    status = payload.get("status", "<missing>")
    gateway = payload.get("gateway", "<missing>")
    print(f"gateway health {path}: status={status} gateway={gateway}", flush=True)
    healthy = healthy or status == "ok" or gateway == "running"
if not healthy:
    print("gateway health diagnosis: no usable health endpoint", flush=True)
PY
}

wait_for_gateway_health() {
  i=0
  while [ "$i" -lt 90 ]; do
    is_running || return 1
    if gateway_health_is_ready; then return 0; fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

start_viewer() {
  if viewer_is_running; then
    return 0
  fi
  test -f "$VIEWER_SCRIPT"
  setsid "$PYTHON_BIN" "$VIEWER_SCRIPT" >>"$VIEWER_LOG" 2>&1 &
  echo $! >"$VIEWER_PIDFILE"
}

stop_viewer() {
  if ! viewer_is_running; then
    rm -f "$VIEWER_PIDFILE"
    return 0
  fi
  viewer_pid=$(cat "$VIEWER_PIDFILE")
  kill -TERM -- "-$viewer_pid" 2>/dev/null || kill -TERM "$viewer_pid" 2>/dev/null || true
  i=0
  while viewer_is_running && [ "$i" -lt 10 ]; do
    sleep 1
    i=$((i + 1))
  done
  if viewer_is_running; then
    kill -KILL -- "-$viewer_pid" 2>/dev/null || kill -KILL "$viewer_pid" 2>/dev/null || true
  fi
  rm -f "$VIEWER_PIDFILE"
}

start() {
  if is_running; then
    echo 'Hermes Agent is already running'
    exit 0
  fi
  "$(dirname "$0")/ensure_runtime"
  sync_bundled_skills
  configure_browser_backend
  log_msg "start requested; appdest=${APP_ROOT}; pkgvar=${PKG_VAR}; hermes_home=${HERMES_HOME}; workspace=${WORKSPACE_DIR:-<not-set>}"
  log_msg "browser backend=${BROWSER_BACKEND}; cdp=${BROWSER_CDP_URL:-<not-connected>}; fallback_chromium=${AGENT_BROWSER_EXECUTABLE_PATH}"
  test -x "${APP_ROOT}/bin/hermes-fnos"
  umask 077
  start_viewer
  # fnOS is the service supervisor. Do not call `gateway start`: that command
  # expects Hermes to have installed its own systemd user service, which is
  # neither needed nor suitable for a native fnOS application.
  setsid "${APP_ROOT}/bin/hermes-fnos" gateway run >>"${AGENT_LOG}" 2>&1 &
  echo $! >"${PIDFILE}"
  if ! wait_for_gateway_health; then
    gateway_health_diagnose
    log_msg "gateway failed to become healthy; inspect gateway.log and log-viewer.log"
    stop
    echo 'Hermes Agent did not become healthy; check the application log.' >&2
    exit 1
  fi
  log_msg "gateway started; gateway_port=${HERMES_GATEWAY_PORT}; log_viewer_port=${HERMES_LOG_VIEWER_PORT}"
}

stop() {
  log_msg "stop requested"
  if ! is_running; then
    rm -f "$PIDFILE"
    stop_viewer
    return 0
  fi
  pid=$(cat "$PIDFILE")
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  i=0
  while is_running && [ "$i" -lt 30 ]; do
    sleep 1
    i=$((i + 1))
  done
  if is_running; then
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
  stop_viewer
  log_msg "stopped"
}

status() {
  if is_running; then
    if viewer_is_running; then
      echo "Hermes Agent is running on port ${HERMES_GATEWAY_PORT}; logs on port ${HERMES_LOG_VIEWER_PORT}"
    else
      echo "Hermes Agent is running on port ${HERMES_GATEWAY_PORT}; log viewer is not running" >&2
    fi
    exit 0
  fi
  echo 'Hermes Agent is not running' >&2
  exit 3
}

logs() {
  case "${2:-all}" in
    all) files="${LOG_DIR}"/*.log ;;
    install|app|gateway|browser|log-viewer) files="${LOG_DIR}/${2}.log" ;;
    *) echo "Usage: $0 logs {all|install|app|gateway|browser|log-viewer}" >&2; exit 2 ;;
  esac
  for file in $files; do
    [ -f "$file" ] || continue
    echo "===== $(basename "$file") ====="
    tail -n "${HERMES_LOG_LINES:-300}" "$file"
  done
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) logs "$@" ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
