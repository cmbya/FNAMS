#!/bin/sh

# Shared, dependency-free configuration writers used during install, upgrade,
# and fnOS App Settings callbacks. Values are shell-quoted because authorized
# paths may contain spaces or non-ASCII characters and app.env is sourced by
# the lifecycle scripts.

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\"'\"'/g"
  printf "'"
}

first_authorized_path() {
  value=${1:-}
  printf '%s' "${value%%:*}"
}

write_agent_env() {
  config_dir=$1
  configured_home=$2
  configured_workspace=$3
  temp_file=${config_dir}/app.env.tmp.$$
  umask 077
  {
    printf 'HERMES_HOME='; shell_quote "$configured_home"; printf '\n'
    printf 'WORKSPACE_DIR='; shell_quote "$configured_workspace"; printf '\n'
    printf 'HERMES_GATEWAY_PORT=8642\n'
  } >"$temp_file"
  chmod 0600 "$temp_file" 2>/dev/null || true
  mv -f "$temp_file" "${config_dir}/app.env"
}

write_agent_metadata() {
  app_root=$1
  configured_home=$2
  configured_workspace=$3
  metadata_file=${app_root}/.hermes-agent-fnos.env
  temp_file=${metadata_file}.tmp.$$
  umask 077
  {
    printf '# Generated by Hermes Agent for Hermes Studio. Contains paths only.\n'
    printf 'HERMES_HOME='; shell_quote "$configured_home"; printf '\n'
    printf 'WORKSPACE_DIR='; shell_quote "$configured_workspace"; printf '\n'
  } >"$temp_file"
  chmod 0644 "$temp_file" 2>/dev/null || true
  mv -f "$temp_file" "$metadata_file"
}
